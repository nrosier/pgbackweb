{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy"],
  "env": {
    "GOPROXY": "https://proxy.golang.org,direct",
    "GOPRIVATE": ""
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "addLabels": ["github-actions"]
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm dependencies",
      "addLabels": ["npm"]
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "addLabels": ["go"]
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Docker base images",
      "addLabels": ["docker"]
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "Pinned CLI tool versions",
      "addLabels": ["docker"]
    },
    {
      "matchPackageNames": ["golang", "golangci/golangci-lint"],
      "groupName": "Go toolchain (golang image + golangci-lint)",
      "addLabels": ["docker"]
    },
    {
      "matchPackageNames": ["github.com/nodxdev/nodxgo**"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "nodxgo renamed its module path to github.com/varavelio/nodxgo as of v1.x; skip until we deliberately migrate imports."
    },
    {
      "matchPackageNames": ["github.com/labstack/echo/v4"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "echo v5 changes the import path across all usages and changes RealIP() to no longer trust X-Forwarded-For/X-Real-IP by default; skip until we deliberately migrate and configure IPExtractor."
    },
    {
      "matchPackageNames": ["tailwindcss", "daisyui"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "Tailwind v4 and daisyUI v5 require migrating to a CSS-first config and a new CLI package; skip until we deliberately migrate."
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["/^docker/Dockerfile(\\.dev)?$/"],
      "matchStrings": [
        "github\\.com/(?<depName>[\\w-]+/[\\w-]+)/releases/download/(?<currentValue>v[\\w.]+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["/^docker/Dockerfile(\\.dev)?$/"],
      "matchStrings": ["(?:^|\\n)\\s*n (?<currentValue>\\d+\\.\\d+\\.\\d+) &&"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    }
  ]
}
