# Encryption key is used to encrypt and decrypt the sensitive data stored
# in the database such as database credentials, secret keys, etc.
PBW_ENCRYPTION_KEY=""

# Database connection string for a PostgreSQL database where the pgbackweb
# will store its data.
PBW_POSTGRES_CONN_STRING=""

# The host on which the pgbackweb will listen for incoming HTTP requests.
PBW_LISTEN_HOST=""

# The port on which the pgbackweb will listen for incoming HTTP requests.
PBW_LISTEN_PORT=""

# Path prefix to use for all routes. If you set this to e.g. "/pgbackweb",
# the web interface will be available at http://<host>:<port>/pgbackweb
PBW_PATH_PREFIX=""

# Your timezone, this impacts logging, backup filenames and default timezone
# in the web interface.
TZ=""

# Set to "true" to enable OIDC/SSO login. When enabled, PBW_OIDC_ISSUER_URL,
# PBW_OIDC_CLIENT_ID, PBW_OIDC_CLIENT_SECRET and PBW_OIDC_REDIRECT_URL below
# are all required. OIDC logs into the single existing user account (by
# matching identity, then by verified email) rather than creating new
# accounts, except on a fresh install with no users yet.
PBW_OIDC_ENABLED="false"

# The issuer URL of your OIDC identity provider, used for discovery.
PBW_OIDC_ISSUER_URL=""

# The OAuth2 client ID and secret registered with your identity provider.
PBW_OIDC_CLIENT_ID=""
PBW_OIDC_CLIENT_SECRET=""

# The callback URL registered with your identity provider. Its path must be
# exactly "<PBW_PATH_PREFIX>/auth/oidc/callback" - if you set PBW_PATH_PREFIX
# above, remember to include it here too, e.g.
# "https://backups.example.com/pgbackweb/auth/oidc/callback".
PBW_OIDC_REDIRECT_URL=""
